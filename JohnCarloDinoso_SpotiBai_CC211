      <!-- Navigation Links -->
      <nav class="nav-links-group" aria-label="Primary Navigation">
        <a href="#home" class="active">Home</a>
        <a href="#music">Music</a>
        <a href="#podcast">Podcast</a>
        <a href="#settings">Settings</a>
      </nav>

      <!-- Search Bar -->
      <div class="search-pill">
        <i class="bi bi-search"></i>
        <input
          type="text"
          id="trackSearchInput"
          aria-label="Search tracks or artists"
          placeholder="Search..."
        />
      </div>
    </header>

    <!-- Advertisement Banner Section (Image 3) -->
    <section class="ad-wrapper" id="adBannerWrapper" aria-label="Advertisement">
      <div class="ad-banner">
        <button
          type="button"
          class="ad-close-btn"
          id="closeAdBtn"
          aria-label="Close advertisement"
          title="Close advertisement"
        >
          X
        </button>

        <!-- Attempts local image3.png first; falls back seamlessly to the styled banner -->
        <img
          src="image3.png"
          alt="Advertisement Banner"
          class="ad-banner-img"
          id="adBannerImg"
          onerror="this.style.display='none'; document.getElementById('adFallbackBox').style.display='flex';"
        />

        <div class="ad-fallback" id="adFallbackBox" style="display: none;">
          <p class="ad-headline">
            The fan-made ‘I don’t give a s*** what the calendar says, it’s christmas’ playlist is about to be correct for the first time in 2018.
