              />
              <div class="play-overlay"><i class="bi bi-play-fill"></i></div>
            </div>
            <div class="track-info">
              <p class="track-title">Suicidal</p>
              <p class="track-artist">YNW Melly</p>
            </div>
          </div>
        </div>

        <!-- Row 2, Right: Image 5 -> President Carter | LIL WAYNE -->
        <div class="col-12 col-sm-6 track-item" data-search="president carter lil wayne">
          <div class="track-card" data-track="President Carter — LIL WAYNE">
            <div class="track-cover-wrap">
              <img
