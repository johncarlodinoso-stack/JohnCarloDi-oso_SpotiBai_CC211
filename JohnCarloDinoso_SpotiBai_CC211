                <polygon points="50,32 18,66 82,66" fill="#17693b" />
                <polygon points="50,50 14,84 86,84" fill="#125831" />
                <polygon points="50,6 52.5,12 59,12 53.8,15.8 55.8,22 50,18.2 44.2,22 46.2,15.8 41,12 47.5,12" fill="#fff3b0" />
                <circle cx="42" cy="40" r="3" fill="#ff595e" />
                <circle cx="58" cy="38" r="3" fill="#ffca3a" />
                <circle cx="35" cy="58" r="3.2" fill="#8ac926" />
                <circle cx="64" cy="59" r="3.2" fill="#ff595e" />
                <circle cx="48" cy="62" r="3" fill="#ffffff" />
                <circle cx="30" cy="76" r="3.5" fill="#ffca3a" />
