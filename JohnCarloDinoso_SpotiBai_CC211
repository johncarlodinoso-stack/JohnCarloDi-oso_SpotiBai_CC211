  <!-- Toast Notification -->
  <div class="status-toast" id="statusToast" role="status" aria-live="polite"></div>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Toast Notification Helper
      const toastEl = document.getElementById('statusToast');
      let toastTimer;

      function showToast(message) {
        toastEl.textContent = message;
        toastEl.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toastEl.classList.remove('show');
        }, 2800);
      }

      // 2. Dismissible Advertisement Banner
      const closeAdBtn = document.getElementById('closeAdBtn');
      const adBannerWrapper = document.getElementById('adBannerWrapper');

      if (closeAdBtn && adBannerWrapper) {
        closeAdBtn.addEventListener('click', () => {
          adBannerWrapper.classList.add('dismissed');
        });
      }

      // 3. Track Playback Toggle & Live Search Filter
      const trackCards = document.querySelectorAll('.track-card');
      trackCards.forEach((card) => {
        card.addEventListener('click', () => {
          const isAlreadyPlaying = card.classList.contains('playing');
          trackCards.forEach((c) => {
            c.classList.remove('playing');
            const icon = c.querySelector('.play-overlay i');
            if (icon) icon.className = 'bi bi-play-fill';
          });

          if (!isAlreadyPlaying) {
            card.classList.add('playing');
            const icon = card.querySelector('.play-overlay i');
            if (icon) icon.className = 'bi bi-pause-fill';
            showToast(`Now Playing: ${card.dataset.track}`);
          } else {
            showToast('Playback paused');
          }
        });
      });

      const searchInput = document.getElementById('trackSearchInput');
      const trackItems = document.querySelectorAll('.track-item');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.trim().toLowerCase();
          trackItems.forEach((item) => {
            const haystack = item.dataset.search || '';
            item.style.display = haystack.includes(query) ? '' : 'none';
          });
        });
      }

      // 4. Draggable, continuously rotating Album/Artist Carousel
      const carousel = document.getElementById('albumCarousel');

      if (carousel) {
        // Duplicate the artist tiles so the carousel can rotate seamlessly.
        const originalSlides = Array.from(carousel.children);
        originalSlides.forEach((slide) => {
          const clone = slide.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.classList.add('carousel-clone');
          carousel.appendChild(clone);
        });

        let isDragging = false;
        let hasDragged = false;
        let startX = 0;
        let startScrollLeft = 0;
        let pointerId = null;
        let isPaused = false;
        let previousFrameTime = 0;
        const rotationSpeed = 28; // pixels per second

        const pauseRotation = () => { isPaused = true; };
        const resumeRotation = () => {
          isPaused = false;
          previousFrameTime = 0;
        };

        // Smooth, seamless auto-rotation. The duplicated half is reset invisibly.
        const rotateCarousel = (time) => {
          if (!previousFrameTime) previousFrameTime = time;
          const delta = Math.min((time - previousFrameTime) / 1000, 0.05);
          previousFrameTime = time;

          if (!isPaused && !isDragging) {
            const loopPoint = carousel.scrollWidth / 2;
            carousel.scrollLeft += rotationSpeed * delta;
            if (loopPoint > 0 && carousel.scrollLeft >= loopPoint) {
              carousel.scrollLeft -= loopPoint;
            }
          }
          requestAnimationFrame(rotateCarousel);
        };
        requestAnimationFrame(rotateCarousel);

        carousel.addEventListener('mouseenter', pauseRotation);
        carousel.addEventListener('mouseleave', resumeRotation);
        carousel.addEventListener('focusin', pauseRotation);
        carousel.addEventListener('focusout', resumeRotation);

        // Pointer dragging works with a mouse, touch screen, or stylus.
        carousel.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          isDragging = true;
          hasDragged = false;
          pointerId = e.pointerId;
          startX = e.clientX;
          startScrollLeft = carousel.scrollLeft;
          carousel.classList.add('active-drag');
          pauseRotation();
          carousel.setPointerCapture(pointerId);
        });

        carousel.addEventListener('pointermove', (e) => {
          if (!isDragging || e.pointerId !== pointerId) return;
          const distance = e.clientX - startX;
          if (Math.abs(distance) > 5) hasDragged = true;
          if (hasDragged) {
            e.preventDefault();
            const loopPoint = carousel.scrollWidth / 2;
            carousel.scrollLeft = startScrollLeft - distance * 1.35;

            // Keep manual dragging seamless across either end of the loop.
            if (loopPoint > 0 && carousel.scrollLeft < 0) {
              carousel.scrollLeft += loopPoint;
              startScrollLeft += loopPoint;
            } else if (loopPoint > 0 && carousel.scrollLeft >= loopPoint) {
              carousel.scrollLeft -= loopPoint;
              startScrollLeft -= loopPoint;
            }
          }
        });

        const finishDragging = (e) => {
          if (!isDragging || (e && e.pointerId !== pointerId)) return;
          isDragging = false;
          pointerId = null;
          carousel.classList.remove('active-drag');
          // Keep rotation paused briefly after a drag, then resume automatically.
          window.setTimeout(() => {
            if (!carousel.matches(':hover') && !carousel.contains(document.activeElement)) {
              resumeRotation();
            }
          }, 900);
        };

        carousel.addEventListener('pointerup', finishDragging);
        carousel.addEventListener('pointercancel', finishDragging);
        carousel.addEventListener('lostpointercapture', finishDragging);

        // Avoid selecting an artist when the user's gesture was actually a drag.
        carousel.querySelectorAll('.album-slide:not(.carousel-clone)').forEach((slide) => {
          slide.addEventListener('click', (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopPropagation();
              hasDragged = false;
              return;
            }
            const artist = slide.dataset.artist;
            if (artist) showToast(`Selected Artist: ${artist}`);
          });
        });

        // Cloned tiles are decorative copies, not separate selectable artists.
        carousel.querySelectorAll('.carousel-clone').forEach((slide) => {
          slide.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
          });
        });
      }

      // 5. Contact Form Submission
      const contactForm = document.getElementById('contactForm');
      if (contactForm) {
        contactForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const nameVal = document.getElementById('contactName').value.trim();
          const emailVal = document.getElementById('contactEmail').value.trim();
          const msgVal = document.getElementById('contactMessage').value.trim();

          if (!nameVal || !emailVal || !msgVal) {
            showToast('Please fill out Name, Email, and Message.');
            return;
          }

          showToast(`Thanks ${nameVal}! Your message has been sent.`);
          contactForm.reset();
        });
      }
    });
  </script>
